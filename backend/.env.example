# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/primepredict

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Site URL
SITE_URL=http://localhost:3000

# Email (optional)
EMAIL_FROM=noreply@primepredict.co.ke
EMAIL_PROVIDER=console

# SendGrid (optional)
SENDGRID_API_KEY=

# Mailgun (optional)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Payment Providers (add your API keys)
# M-Pesa
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Coinbase Commerce
COINBASE_API_KEY=
COINBASE_WEBHOOK_SECRET=


# Initial administrator (used only by npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_NAME=Administrator
