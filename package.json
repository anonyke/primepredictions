{
  "name": "primepredictions",
  "private": true,
  "version": "1.0.0",
  "description": "PrimePredict - Premium Football Prediction Platform (monorepo root)",
  "workspaces": ["backend"],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace backend",
    "start": "npm run start --workspace backend",
    "dev": "npm run dev --workspace backend",
    "install:frontend": "npm --prefix frontend install",
    "build:frontend": "npm --prefix frontend run build",
    "start:frontend": "npm --prefix frontend run start"
  }
}
